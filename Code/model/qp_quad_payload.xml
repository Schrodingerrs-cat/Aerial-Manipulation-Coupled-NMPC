<mujoco model="quad_payload">
  <!-- Payload study (2026-11-10): the v3 airframe without the arm (1.05 kg, same inertia, rotors, propulsion) carrying a 0.2 kg load on a 0.6 m string.
       String = massless rigid link on a ball joint at the airframe centre (taut-cable assumption, chosen with the user). No air drag, no joint damping. -->
  <compiler angle="radian"/>
  <option timestep="0.0005" gravity="0 0 -9.81"/>
  <visual><global offwidth="1920" offheight="1080"/><quality shadowsize="4096" offsamples="8"/><headlight ambient="0.35 0.35 0.35" diffuse="0.55 0.55 0.55" specular="0.1 0.1 0.1"/></visual>
  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.62 0.75 0.92" rgb2="0.16 0.20 0.30" width="512" height="512"/>
    <texture name="floortex" type="2d" builtin="checker" width="512" height="512" rgb1="0.7 0.7 0.75" rgb2="0.35 0.35 0.4"/>
    <material name="grid" texture="floortex" texrepeat="10 10" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="-0.4 -1.2 3.5" dir="0.3 0.5 -1" directional="true" castshadow="true" diffuse="0.75 0.75 0.75" specular="0.2 0.2 0.2"/>
    <geom name="floor" type="plane" size="10 10 0.1" material="grid" contype="0" conaffinity="0"/>
    <body name="drone" pos="0 0 1.5">
      <freejoint name="base"/>
      <inertial pos="0 0 0" mass="1.05" fullinertia="0.0017969 0.0017969 0.003454 0 0 0"/>
      <geom name="drone_core" type="box" size="0.035 0.035 0.015" rgba="1 0.9 0.1 1" density="0" contype="0" conaffinity="0"/>
      <geom type="box" pos=".071 .071 0" size="0.05 0.01 0.0025" quat=".924 0 0 .383" rgba="1 .5 0 1" density="0" contype="0" conaffinity="0"/>
      <geom type="box" pos=".071 -.071 0" size="0.05 0.01 0.0025" quat=".383 0 0 .924" rgba="1 .5 0 1" density="0" contype="0" conaffinity="0"/>
      <geom type="box" pos="-.071 -.071 0" size="0.05 0.01 0.0025" quat="-.383 0 0 .924" rgba="1 .5 0 1" density="0" contype="0" conaffinity="0"/>
      <geom type="box" pos="-.071 .071 0" size="0.05 0.01 0.0025" quat=".924 0 0 -.383" rgba="1 .5 0 1" density="0" contype="0" conaffinity="0"/>
      <site name="rotor0" pos="0.1 0.1 0.01"/><geom type="cylinder" pos="0.1 0.1 0.01" size="0.089 0.002" rgba="0.1 0.1 0.1 0.35" density="0" contype="0" conaffinity="0"/>
      <site name="rotor1" pos="0.1 -0.1 0.01"/><geom type="cylinder" pos="0.1 -0.1 0.01" size="0.089 0.002" rgba="0.1 0.1 0.1 0.35" density="0" contype="0" conaffinity="0"/>
      <site name="rotor2" pos="-0.1 -0.1 0.01"/><geom type="cylinder" pos="-0.1 -0.1 0.01" size="0.089 0.002" rgba="0.1 0.1 0.1 0.35" density="0" contype="0" conaffinity="0"/>
      <site name="rotor3" pos="-0.1 0.1 0.01"/><geom type="cylinder" pos="-0.1 0.1 0.01" size="0.089 0.002" rgba="0.1 0.1 0.1 0.35" density="0" contype="0" conaffinity="0"/>
      <body name="load" pos="0 0 0">
        <joint name="cable" type="ball"/>
        <geom name="string" type="capsule" fromto="0 0 0 0 0 -0.6" size="0.003" rgba="0.15 0.15 0.15 1" density="0" contype="0" conaffinity="0"/>
        <geom name="mass" type="sphere" pos="0 0 -0.6" size="0.035" rgba="0.2 0.4 0.9 1" density="0" contype="0" conaffinity="0"/>
        <inertial pos="0 0 -0.6" mass="0.2" diaginertia="1e-6 1e-6 1e-6"/>
