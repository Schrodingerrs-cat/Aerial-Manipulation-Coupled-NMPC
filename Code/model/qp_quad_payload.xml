    </body>
  </worldbody>
  <actuator>
    <motor site="rotor0" gear="0 0 1 0 0 0.016" ctrllimited="true" ctrlrange="0 10.0"/>
    <motor site="rotor1" gear="0 0 1 0 0 -0.016" ctrllimited="true" ctrlrange="0 10.0"/>
    <motor site="rotor2" gear="0 0 1 0 0 0.016" ctrllimited="true" ctrlrange="0 10.0"/>
    <motor site="rotor3" gear="0 0 1 0 0 -0.016" ctrllimited="true" ctrlrange="0 10.0"/>
  </actuator>
